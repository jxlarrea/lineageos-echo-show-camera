// Built inside the LineageOS tree (see build.sh), which supplies the WebRTC
// audio processing library the ROM already ships in /vendor/lib.
cc_library_shared {
    name: "libamznaec_shim",
    vendor: true,
    compile_multilib: "32",
    srcs: [
        "amznaec_shim.cpp",
        "speexdsp/libspeexdsp/mdf.c",
        "speexdsp/libspeexdsp/preprocess.c",
        "speexdsp/libspeexdsp/filterbank.c",
        "speexdsp/libspeexdsp/fftwrap.c",
        "speexdsp/libspeexdsp/kiss_fft.c",
        "speexdsp/libspeexdsp/kiss_fftr.c",
    ],
    local_include_dirs: [
        "speexdsp/include",
        "speexdsp/libspeexdsp",
    ],
    include_dirs: [
        "external/webrtc",
        "external/tinyalsa/include",
    ],
    shared_libs: [
        "libwebrtc_audio_preprocessing",
        "libcutils",
        "liblog",
        "libdl",
    ],
    cflags: [
        "-DWEBRTC_POSIX",
        "-DFLOATING_POINT",
        "-DUSE_KISS_FFT",
        "-DEXPORT=",
        "-DVAR_ARRAYS",
        "-Wall",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-implicit-fallthrough",
    ],
}
