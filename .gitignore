# Proprietary blobs fetched from the firmware dump. NEVER commit these:
# this repository distributes no proprietary binaries.
stock/

# Device backups, session logs, and build outputs are local-only.
backups/
logs/
prebuilt-artifacts/

# Build outputs, including bionic libraries pulled from the device
# (proprietary; the build scripts re-pull them from the target).
tools/cmdq-trace/out/
shims/*/out/

# Editor workspace
*.code-workspace

# Local AI tooling config
.claude/

# Original camera-roll captures; the encoded demo is committed instead.
assets/2026*.mp4
