 // shared memory methods
+/*
+ * MediaTek's legacy camera1 HAL on mt8163 (libcam.client.so) invokes the
+ * get_memory callback without forwarding the cookie that was handed to
+ * set_callbacks(), so `user` arrives NULL and the deref below faults:
+ *   CameraDevice::sGetMemory+18, fault addr 0x8c (offset of mDeviceCallback)
+ * called from NSPrvCbClient::PrvCbImgBuf::alloc during startPreview.
+ *
+ * There is only ever one open CameraDevice in this process, so fall back to
+ * the device recorded at open() when the HAL loses the cookie. Same treatment
+ * for the notify/data callbacks, which deref `user` identically.
+ */
+static CameraDevice* sCookielessFallbackDevice = nullptr;
+
+static CameraDevice* resolveCallbackDevice(void* user, const char* who) {
+    if (user != nullptr) {
+        return static_cast<CameraDevice*>(user);
+    }
+    if (sCookielessFallbackDevice == nullptr) {
+        ALOGE("%s: HAL passed no cookie and no device is open", who);
+    }
+    return sCookielessFallbackDevice;
+}
+
 camera_memory_t* CameraDevice::sGetMemory(int fd, size_t buf_size, uint_t num_bufs, void *user) {
     ALOGV("%s", __FUNCTION__);
-    CameraDevice* object = static_cast<CameraDevice*>(user);
+    CameraDevice* object = resolveCallbackDevice(user, __FUNCTION__);
+    if (object == nullptr) {
+        return nullptr;
+    }
     if (object->mDeviceCallback == nullptr) {
         ALOGE("%s: camera HAL request memory while camera is not opened!", __FUNCTION__);
         return nullptr;
