+// Legacy vendor HALs can leave a String8 in the map whose SharedBuffer has
+// mSize == 0, a state the pre-sanitizer String8 treated as an empty string.
+// libutils is now built with the integer sanitizer, so String8::length()
+// underflows and aborts on such a value. Inspect the raw buffer instead of
+// asking String8, and skip entries that would trap.
+static bool isSaneParamString(const String8& s, const char** outPtr,
+                              uint32_t* outSize) {
+    const char* p = *reinterpret_cast<const char* const*>(&s);
+    *outPtr = p;
+    *outSize = 0;
+    if (p == nullptr) return false;
+    // SharedBuffer header precedes the data; mSize sits 12 bytes before it
+    // on 32-bit builds (16-byte header, mSize at offset 4).
+    const uint32_t sz = reinterpret_cast<const uint32_t*>(p)[-3];
+    *outSize = sz;
+    return sz != 0 && p[sz - 1] == '\0';
+}
