+ * (0=normal 1=H 2=V 3=HV).
+ */
+static int ov02b10_flip_page = 0x01;
+module_param(ov02b10_flip_page, int, 0644);
+static int ov02b10_flip_reg = 0x12;
+module_param(ov02b10_flip_reg, int, 0644);
