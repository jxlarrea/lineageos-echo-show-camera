<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local overrides on top of amazon-oss/local_manifests.

  Sorted after amazon_mt8163.xml so repo has already defined these projects by
  the time the removals are processed.
-->
<manifest>
  <!--
    amazon-oss/android_hardware_mediatek_mt66xx does not exist (GitHub 404), so
    every sync fails on it. Nothing needs it: no device tree under
    device/amazon/ references mt66xx, and cronos, crown and checkers all select
    mt76xx in their BoardConfig. The kernel/amazon/mt66xx-* projects are
    unrelated and do exist.
  -->
  <remove-project name="android_hardware_mediatek_mt66xx" />

  <!--
    These three are large. They used to be removed here, on the theory that
    the build only needs their files and they could be checked out once and
    then dropped from repo's management. That is wrong for anyone starting
    from a fresh sync: prebuilts/tools carries truth-prebuilt,
    gson-prebuilt-jar, metalava's deps and the robolectric jars, so without
    it Soong fails immediately with a wall of "depends on undefined module".
    They are left in the manifest deliberately: the shallow repo init in
    the install guide already keeps the fetch small.
  -->

  <!--
    BoardConfigCommon.mk points TARGET_KERNEL_CROSS_COMPILE_PREFIX at
    prebuilts/linaro, which no published manifest provides, so the kernel
    cannot be built as checked out. The tree's own aarch64-linux-android-4.9
    is not a substitute - this kernel requires GCC 5.1 or newer. This repo has
    the expected layout and Linaro GCC 6.3.1. The branch is irrelevant for a
    toolchain.
  -->
  <remote name="mt8163" fetch="https://github.com/mt8163" />
  <project path="prebuilts/linaro" name="android_prebuilts_linaro"
           remote="mt8163" revision="refs/heads/lineage-21.0"
           clone-depth="1" />
</manifest>
