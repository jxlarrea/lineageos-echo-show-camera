apexer: use the tree's mke2fs.conf when building apex payloads

apexer builds each apex payload with the tree's own mke2fs (e2fsprogs
1.45.4, 2019), but RunCommand replaces the environment wholesale with a
single variable, so mke2fs finds no MKE2FS_CONFIG and falls back to the
host's /etc/mke2fs.conf.

On a current distribution that config enables features the 2019 binary
rejects outright:

    Invalid filesystem option set: has_journal,extent,huge_file,flex_bg,
    metadata_csum,metadata_csum_seed,64bit,dir_nlink,extra_isize,orphan_file

which fails the ART apex and stops the build at 97%. Debian 13 is where
this was hit; anything shipping e2fsprogs 1.47 or newer will do it.

Exporting MKE2FS_CONFIG does not help on its own, because Soong strips
the environment for hermetic builds and the variable never reaches
apexer. So this honours MKE2FS_CONFIG when it is set, and otherwise falls
back to the config the tree already ships at
system/extras/ext4_utils/mke2fs.conf, resolved from the working directory
(ninja runs actions from the top of the source tree).

Apply from the source tree root:
    patch -p1 < 0012-apexer-mke2fs-conf.patch

diff --git a/system/apex/apexer/apexer.py b/system/apex/apexer/apexer.py
index f698c8c..b270e8e 100644
--- a/system/apex/apexer/apexer.py
+++ b/system/apex/apexer/apexer.py
@@ -428,6 +428,31 @@ def AddLoggingParent(android_manifest, logging_parent_value):
       write_xml(temp, doc)
       return temp.name
 
+def _e2fsprogs_env():
+  """Environment for the tree's e2fsprogs tools.
+
+  RunCommand replaces the environment wholesale, so mke2fs would fall back
+  to the host's /etc/mke2fs.conf. The tree's mke2fs is from 2019 and a
+  current distribution's config enables features it rejects outright
+  ("Invalid filesystem option set: ... metadata_csum_seed,orphan_file").
+  Forwarding MKE2FS_CONFIG lets the caller point it at the tree's own
+  system/extras/ext4_utils/mke2fs.conf.
+  """
+  env = {'E2FSPROGS_FAKE_TIME': '1'}
+  conf = os.environ.get('MKE2FS_CONFIG')
+  if not conf:
+    # Soong strips the environment for hermetic builds, so exporting
+    # MKE2FS_CONFIG does not reach us. Ninja runs actions from the top of
+    # the source tree, so fall back to the config the tree ships.
+    default = os.path.join(os.getcwd(),
+                           'system/extras/ext4_utils/mke2fs.conf')
+    if os.path.exists(default):
+      conf = default
+  if conf:
+    env['MKE2FS_CONFIG'] = conf
+  return env
+
+
 def CreateApex(args, work_dir):
   if not ValidateArgs(args):
     return False
@@ -499,7 +524,7 @@ def CreateApex(args, work_dir):
     cmd.extend(['-E', 'hash_seed=' + uu])
     cmd.append(img_file)
     cmd.append(str(size_in_mb) + 'M')
-    RunCommand(cmd, args.verbose, {'E2FSPROGS_FAKE_TIME': '1'})
+    RunCommand(cmd, args.verbose, _e2fsprogs_env())
 
     # Compile the file context into the binary form
     compiled_file_contexts = os.path.join(work_dir, 'file_contexts.bin')
@@ -517,7 +542,7 @@ def CreateApex(args, work_dir):
     cmd.extend(['-C', args.canned_fs_config])
     cmd.append('-s')  # share dup blocks
     cmd.append(img_file)
-    RunCommand(cmd, args.verbose, {'E2FSPROGS_FAKE_TIME': '1'})
+    RunCommand(cmd, args.verbose, _e2fsprogs_env())
 
     cmd = ['e2fsdroid']
     cmd.append('-e')  # input is not android_sparse_file
@@ -527,13 +552,13 @@ def CreateApex(args, work_dir):
     cmd.extend(['-C', args.canned_fs_config])
     cmd.append('-s')  # share dup blocks
     cmd.append(img_file)
-    RunCommand(cmd, args.verbose, {'E2FSPROGS_FAKE_TIME': '1'})
+    RunCommand(cmd, args.verbose, _e2fsprogs_env())
 
     # Resize the image file to save space
     cmd = ['resize2fs']
     cmd.append('-M')  # shrink as small as possible
     cmd.append(img_file)
-    RunCommand(cmd, args.verbose, {'E2FSPROGS_FAKE_TIME': '1'})
+    RunCommand(cmd, args.verbose, _e2fsprogs_env())
 
     if args.unsigned_payload_only:
       shutil.copyfile(img_file, args.output)
