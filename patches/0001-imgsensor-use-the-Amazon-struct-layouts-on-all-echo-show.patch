-#ifdef CONFIG_CHECKERS
+/*
+ * Amazon's camera HAL is built against these struct layouts on every
+ * MT8163 Echo Show device, not just checkers. ACDK_SENSOR_INFO_STRUCT
+ * differs from upstream MediaTek's by 20 SensorGrabStart* fields and a
+ * reordering, and the kernel writes it through the pointer the HAL hands
+ * over in KDIMGSENSORIOC_X_GETINFO - so a mismatch feeds the HAL garbage
+ * rather than failing cleanly. ACDK_SENSOR_MCLK_STRUCT also shrinks to the
+ * 8 bytes the HAL encodes into SET_MCLK_PLL's ioctl number.
+ */
+#if defined(CONFIG_CHECKERS) || defined(CONFIG_CRONOS) || \
+	defined(CONFIG_CROWN) || defined(CONFIG_ROOK)
 #include "kd_imgsensor_define_checkers.h"
 #else
 #include "kd_imgsensor_define_default.h"
